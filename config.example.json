{
  "teamwork": {
    "base_url": "https://<workspace>.teamwork.com",
    "api_token": ""
  },
  "default_language": "sk",
  "test_skill": {
    "run_tests": "auto",
    "visual_mode": "auto",
    "comment_on_task": false,
    "time_log": true,
    "move_on_pass": "",
    "move_on_fail": "",
    "report_language": "sk",
    "suggest_missing_acceptance_criteria": true,
    "test_runners": {
      "php_unit": "auto",
      "php_browser": "auto",
      "js_unit": "auto",
      "js_browser": "auto"
    },
    "test_globs": [
      "tests/**/*Test.php",
      "tests/**/*Spec.php",
      "tests/**/*.test.{ts,tsx,js,jsx,mjs,cjs}",
      "tests/**/*.spec.{ts,tsx,js,jsx,mjs,cjs}",
      "cypress/e2e/**/*.cy.{ts,tsx,js,jsx}",
      "tests/Browser/**/*.php",
      "tests/e2e/**/*.{ts,tsx,js}",
      "playwright/**/*.spec.{ts,tsx,js}",
      "e2e/**/*.{spec,test}.{ts,tsx,js}"
    ],
    "visual_file_patterns": [
      "\\.(vue|jsx|tsx|svelte|blade\\.php|html)$",
      "^resources/views/"
    ],
    "max_browser_steps": 25,
    "report_output_dir": "./.teamwork-task-test",
    "review_dimensions": [
      "ui_ux",
      "performance",
      "security",
      "reachability",
      "framework"
    ],
    "negative_control": true,
    "tick_acceptance_criteria": true,
    "performance_budgets": {
      "lcp_ms": 2500,
      "cls": 0.1,
      "inp_ms": 200,
      "ttfb_ms": 800
    },
    "reachability": {
      "enabled": true,
      "menu_selector_hint": "nav a[href]",
      "screen_globs": [
        "app/Nova/**/*.php",
        "app/Filament/**/Resources/*.php",
        "resources/js/Pages/**/*.{vue,tsx,jsx}",
        "src/pages/**/*.{tsx,jsx,vue}",
        "src/app/**/page.{tsx,jsx}"
      ],
      "relation_field_markers": [
        "HasMany",
        "HasManyThrough",
        "BelongsToMany",
        "MorphMany",
        "HasOne",
        "MorphToMany"
      ],
      "allow_orphans": []
    },
    "a11y_checks": [
      "disabled_control_has_reason",
      "disabled_control_is_announced",
      "interactive_element_has_accessible_name",
      "translation_key_resolves_to_text",
      "form_control_has_label",
      "image_has_alt"
    ]
  }
}
